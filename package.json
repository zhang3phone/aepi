{
  "name": "aepi-stardust-memory",
  "description": "Amazon Listing image planning and generation workspace.",
  "private": true,
  "version": "0.1.27",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhang3phone/aepi.git"
  },
  "homepage": "https://zhang3phone.github.io/aepi/",
  "bugs": {
    "url": "https://github.com/zhang3phone/aepi/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "proxy": "node scripts/local-api-proxy.mjs",
    "dev:lan": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "mock:api": "node scripts/mock-image-api.mjs",
    "build": "tsc -b && vite build",
    "deploy:cf": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest run",
    "backup:version": "node scripts/backup-version.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.0",
    "core-js": "^3.49.0",
    "fflate": "^0.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "streamdown": "^2.5.0",
    "zustand": "^5.0.5"
  },
  "overrides": {
    "mdast-util-gfm-autolink-literal": "2.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.88.0"
  }
}
