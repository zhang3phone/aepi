# Copy this file to .env.local and fill in your own local secrets.
# Do not commit .env.local.

# OpenAI-compatible image generation or Responses API.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Optional DeepSeek planner configuration.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# Optional local OpenAI-compatible model gateway.
LOCAL_MODEL_API_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL_API_KEY=local

# Optional outbound proxy used only by the local API proxy.
# Example: http://127.0.0.1:7897
DUNCAN_OUTBOUND_PROXY_URL=
